# === YouTube Auto Bot — Environment Variables ===
# Copy this file to .env and fill in your keys.

# Google Gemini API key (required — for story generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Pexels API key (required if no pre-downloaded bg videos in profile folder)
PEXELS_API_KEY=your_pexels_api_key_here

# ElevenLabs API key (optional — falls back to free Edge-TTS if missing)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
